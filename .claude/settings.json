{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --abbrev-ref @{u} >/dev/null 2>&1 && git pull --rebase --autostash 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Pulling latest from GitHub"
          }
        ]
      }
    ]
  }
}
